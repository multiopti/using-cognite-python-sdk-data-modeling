# Copy this file to ".env" (repo root) and fill in real values for LOCAL
# development only. ".env" is already listed in .gitignore -- never commit it.
#
# These are only needed when running the Streamlit app or a Function
# handler OUTSIDE of Cognite Data Fusion (e.g. `streamlit run` on your own
# machine). When deployed inside CDF, credentials are injected automatically
# and none of this is read.
#
# This project (alimentospolarcomercialca) is a DataMosaix / Auth0-backed
# CDF project, not Azure AD -- ask your CDF project admin for a client
# ID/secret with access to the project if you don't have one yet.

BASE_URL=https://aw-was-gp-001.cognitedata.com
PROJECT=alimentospolarcomercialca
TOKEN_URL=https://datamosaix-prod.us.auth0.com/oauth/token
CDF_CLIENT_ID=your-client-id
CDF_CLIENT_SECRET=your-client-secret
