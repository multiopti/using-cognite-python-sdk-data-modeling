      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-athena-datasource",
            "uid": "${ds}"
          },
          "format": 1,
          "rawSQL": "WITH d AS (SELECT machine, max_by(production, slot) AS p, max_by(observations, slot) AS o FROM polar_production.production_hourly WHERE shift_date = '${fecha}' AND shift = '${turno}' GROUP BY machine) SELECT concat(cast(count_if(p > 0) AS varchar), ' / 32') AS \"Activas\" FROM d",
          "connectionArgs": {
            "region": "__default",
            "catalog": "__default",
            "database": "__default",
            "resultReuseEnabled": false,
            "resultReuseMaxAgeInMinutes": 60
          }
        }
      ],
