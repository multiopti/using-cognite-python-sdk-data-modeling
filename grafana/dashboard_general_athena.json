    {
      "id": 7,
      "type": "stat",
      "title": "Línea 1 · Estado de máquinas (13)",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "grafana-athena-datasource",
        "uid": "${ds}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-athena-datasource",
            "uid": "${ds}"
          },
          "format": 1,
          "rawSQL": "WITH m(machine, line, ord) AS (VALUES ('minster_l1', 'L1', 0), ('di11', 'L1', 1), ('di12', 'L1', 2), ('di14', 'L1', 3), ('di15', 'L1', 4), ('di17', 'L1', 5), ('di18', 'L1', 6), ('p11', 'L1', 7), ('ispray11', 'L1', 8), ('ispray12', 'L1', 9), ('ispray13', 'L1', 10), ('ispray14', 'L1', 11), ('ispray15', 'L1', 12), ('minster_l3', 'L3', 13), ('standum31', 'L3', 14), ('standum32', 'L3', 15), ('standum33', 'L3', 16), ('standum34', 'L3', 17), ('standum35', 'L3', 18), ('standum36', 'L3', 19), ('standum37', 'L3', 20), ('standum38', 'L3', 21), ('p31', 'L3', 22), ('p32', 'L3', 23), ('ispray31', 'L3', 24), ('ispray32', 'L3', 25), ('ispray33', 'L3', 26), ('ispray34', 'L3', 27), ('ispray35', 'L3', 28), ('ispray36', 'L3', 29), ('ispray37', 'L3', 30), ('ispray38', 'L3', 31)), d AS (SELECT machine, max_by(production, slot) AS p, max_by(observations, slot) AS o FROM polar_production.production_hourly WHERE shift_date = '${fecha}' AND shift = '${turno}' GROUP BY machine) SELECT upper(m.machine) AS maquina, CASE WHEN d.machine IS NULL THEN 0 WHEN d.p > 0 THEN 1 WHEN lower(coalesce(d.o, '')) LIKE '%falla%' THEN 3 ELSE 2 END AS estado FROM m LEFT JOIN d ON d.machine = m.machine WHERE m.line = 'L1' ORDER BY m.ord",
          "connectionArgs": {
            "region": "__default",
            "catalog": "__default",
            "database": "__default",
            "resultReuseEnabled": false,
            "resultReuseMaxAgeInMinutes": 60
          }
        }
      ],
      "description": "Según la última hora reportada del turno: Operando = con producción; Falla = «falla» en las observaciones; Detenida = sin producción; Sin datos = ninguna hora reportada.",
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": true
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center",
        "orientation": "auto",
        "showPercentChange": false,
        "text": {
          "titleSize": 13,
          "valueSize": 12
        }
      },
      "fieldConfig": {
        "defaults": {
          "displayName": "${__data.fields.maquina}",
          "color": {
            "mode": "fixed"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Sin datos",
                  "color": "#9ca3af",
                  "index": 0
                },
                "1": {
                  "text": "Operando",
                  "color": "#16a34a",
                  "index": 1
                },
                "2": {
                  "text": "Detenida",
                  "color": "#d97706",
                  "index": 2
                },
                "3": {
                  "text": "Falla",
                  "color": "#dc2626",
                  "index": 3
                }
              }
            }
          ]
        },
        "overrides": []
      }
    },
