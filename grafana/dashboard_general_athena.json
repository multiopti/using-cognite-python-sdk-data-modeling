{
  "title": "Dashboard General · Superenvases",
  "uid": "polar-dashboard-general",
  "description": "Todas las máquinas · Línea 1 y Línea 3. Elija fecha y turno en los selectores.",
  "tags": [
    "empresas-polar",
    "produccion"
  ],
  "timezone": "America/Caracas",
  "editable": true,
  "graphTooltip": 0,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timepicker": {
    "hidden": true
  },
  "refresh": "15m",
  "schemaVersion": 39,
  "templating": {
    "list": [
      {
        "type": "datasource",
        "name": "ds",
        "label": "Fuente de datos",
        "query": "grafana-athena-datasource",
        "regex": "/[Pp]olar/",
        "hide": 2,
        "current": {},
        "options": [],
        "refresh": 1
      },
      {
        "type": "query",
        "name": "fecha",
        "label": "Fecha del turno",
        "datasource": {
          "type": "grafana-athena-datasource",
          "uid": "${ds}"
        },
        "definition": "SELECT DISTINCT shift_date FROM polar_production.production_hourly WHERE shift_date >= date_format(current_date - interval '90' day, '%Y-%m-%d') ORDER BY shift_date DESC",
        "query": {
          "rawSQL": "SELECT DISTINCT shift_date FROM polar_production.production_hourly WHERE shift_date >= date_format(current_date - interval '90' day, '%Y-%m-%d') ORDER BY shift_date DESC",
          "format": 1,
          "connectionArgs": {
            "region": "__default",
            "catalog": "__default",
            "database": "__default",
            "resultReuseEnabled": false,
            "resultReuseMaxAgeInMinutes": 60
          }
        },
        "refresh": 1,
        "sort": 0,
        "multi": false,
        "includeAll": false,
        "hide": 0,
        "current": {},
        "options": []
      },
      {
        "type": "custom",
        "name": "turno",
        "label": "Turno",
        "query": "6AM-6PM : day, 6PM-6AM : night",
        "current": {
          "text": "6AM-6PM",
          "value": "day"
        },
        "multi": false,
        "includeAll": false,
        "hide": 0,
        "options": [
          {
            "text": "6AM-6PM",
            "value": "day",
            "selected": true
          },
          {
            "text": "6PM-6AM",
            "value": "night",
            "selected": false
          }
        ]
      }
    ]
  },
