          "format": 1,
          "rawSQL": "SELECT 'Producción' AS \"x\", coalesce(sum(production) FILTER (WHERE machine_type = 'MINSTER'), 0) AS \"Minster\", coalesce(sum(production) FILTER (WHERE machine_type = 'DI'), 0) AS \"D&I\", coalesce(sum(production) FILTER (WHERE machine_type = 'PRINTER'), 0) AS \"Printer\", coalesce(sum(production) FILTER (WHERE machine_type = 'ISPRAY'), 0) AS \"ISpray\" FROM polar_production.production_hourly WHERE shift_date = '${fecha}' AND shift = '${turno}' AND line = 'L1'",
